#include <windows.h>
1 VERSIONINFO
 FILEVERSION @SC_major@,@SC_minor@,@SC_patch@,0
 PRODUCTVERSION @SC_major@,@SC_minor@,@SC_patch@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#if @SC_rc_number@ > 0
 FILEFLAGS VS_FF_PRERELEASE
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "ProductName", "Sentinel Core"
   VALUE "FileDescription", "@SC_RESOURCE_NAME@ Windows x64"
   VALUE "FileVersion", "@SC_FULL_VERSION@"
   VALUE "ProductVersion", "@SC_FULL_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
